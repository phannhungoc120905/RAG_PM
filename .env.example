# =========================
# Cấu hình ứng dụng
# =========================
APP_NAME=RAG_PM
DEBUG=false
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =========================
# Cấu hình cơ sở dữ liệu MySQL
# DATABASE_URL sẽ được build tự động trong config.py
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ragpm
DB_USER=root
DB_PASSWORD=123456

# =========================
# Cấu hình AI model / RAG
# Dev A sẽ đọc các biến này từ settings
# =========================
MODEL_NAME=llama3.2
MODEL_PATH=/models/llama3.2
FAISS_INDEX_PATH=./faiss_index
VECTOR_DIM=4096
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
OCR_LANG=vie

# =========================
# Cấu hình upload file
# =========================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# =========================
# Cấu hình backup
# =========================
BACKUP_DIR=./backups
