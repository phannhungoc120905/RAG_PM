# =========================
# Cau hinh ung dung
# =========================
APP_NAME=RAG_PM
DEBUG=false
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =========================
# Cau hinh SSO noi bo
# Day la bo bien mock de test luong SSO truoc khi noi cong SSO that
# =========================
SSO_ENABLED=true
SSO_PROVIDER_NAME=internal_mock
SSO_SHARED_SECRET=change-me-sso
SSO_AUTO_CREATE_USERS=true

# =========================
# Cau hinh co so du lieu MySQL
# DATABASE_URL se duoc build tu dong trong config.py
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ragpm
DB_USER=root
DB_PASSWORD=

# =========================
# Cau hinh AI model / RAG
# Dev A se doc cac bien nay tu settings
# =========================
MODEL_NAME=llama3.2
MODEL_PATH=/models/llama3.2
FAISS_INDEX_PATH=./faiss_index
VECTOR_DIM=4096
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
OCR_LANG=vie

# =========================
# Cau hinh upload file
# =========================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# =========================
# Cau hinh backup
# =========================
BACKUP_DIR=./backups
